<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="zxcvbn-core" Version="7.0.92" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Neuro/neuro-rounds.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Тема-пример из корня репо — рядом с приложением; свою тему подставляет Theme:Dir. -->
    <None Include="../../theme/**" LinkBase="theme" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
